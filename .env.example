# ============================================
# Bu dosya .env dosyasının ŞABLONUDUR.
# Projeyi klonlayan kişi bu dosyayı .env olarak kopyalayıp kendi değerlerini girer.
# cp .env.example .env
# ============================================

# ============================================
# Veritabanı Ayarları
# ============================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=buraya_guclu_bir_sifre_yaz
POSTGRES_DB=ecommerce

# ============================================
# Uygulama Ayarları
# ============================================
JWT_SECRET_KEY=buraya_guclu_bir_jwt_anahtari_yaz
APP_ENV=development

# ============================================
# Redis Ayarları
# ============================================
REDIS_ADDRESS=redis:6379

# ============================================
# SMTP / Mail Ayarları
# ============================================
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@ecommerce.com

# ============================================
# Banka Ayarları
# ============================================
BANK_NAME="e-commerce bank"
BANK_ACCOUNT_NUMBER="e-commerce"
BANK_IBAN="TR00 1234 5678 9012 3456 7890 12"
BANK_CURRENCY="TRY"